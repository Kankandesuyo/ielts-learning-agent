APP_NAME="IELTS Learning Agent"
ENVIRONMENT="development"
DATABASE_URL="sqlite:///./ielts_agent.db"
RAG_DOCS_PATH="data/ielts_docs"
KNOWLEDGE_DIR="database"
KNOWLEDGE_INDEX_PATH="data/knowledge_index.json"
UPLOAD_DIR="data/uploads"
MAX_UPLOAD_MB=20
USE_LLM=false
LOCAL_DICTIONARY_ENABLED=true
LOCAL_DICTIONARY_DIR="database/legal-dictionaries"
PUBLIC_DICTIONARY_FALLBACK=true
# DeepSeek uses an OpenAI-compatible API. Keep the real key only in .env.
# OPENAI_API_KEY="put-your-deepseek-key-here"
OPENAI_BASE_URL="https://api.deepseek.com"
OPENAI_MODEL="deepseek-v4-flash"
